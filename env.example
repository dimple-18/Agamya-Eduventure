# Copy to .env.local and fill in values from your Supabase project dashboard.
# Works on Vercel and Hiox — same env vars on both hosts.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for one-time data import in /admin. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
